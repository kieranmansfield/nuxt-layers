# Diff-scoped health gates on the staged changeset; tasks live in the `staged` block of
# vite.config.ts. Full-repo scans run in CI (vue-doctor.yml).
# Bypass once with `git commit --no-verify`, or per shell with VP_GIT_HOOKS=0.

# A conflicted merge diffs against the first parent, so code already landed on the other branch
# would count as introduced here. CI's full scan covers the merge result.
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0

# --hide-unstaged stashes every unstaged change first, so the gates see exactly the index.
vp staged --hide-unstaged

{
	"servers": {
		"github": {
			"url": "https://api.githubcopilot.com/mcp/",
			"type": "http"
		},
		"Nuxt": {
			"url": "https://mcp.nuxt.com/sse",
			"type": "http"
		},
		"eslint-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": ["@eslint/mcp@latest"]
		},
		"Netlify MCP": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@netlify/mcp"]
		},
		"drafts": {
			"type": "stdio",
			"command": "drafts-mcp-server",
			"args": []
		},
		"safari-mcp-stp": {
			"command": "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver",
			"args": ["--mcp"]
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": ["@playwright/mcp@latest"],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"io.github.github/github-mcp-server": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.2"
		},
		"io.github.ChromeDevTools/chrome-devtools-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"chrome-devtools-mcp@1.1.1"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.1"
		},
		"antfu/nuxt-mcp": {
			"type": "http",
			"url": "https://mcp.nuxt.com/sse",
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"com.stackoverflow.mcp/mcp": {
			"type": "http",
			"url": "https://mcp.stackoverflow.com",
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.3"
		}
	},
	"inputs": []
}

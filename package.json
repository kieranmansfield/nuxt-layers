{
  "name": "kmcom-nuxt-layers",
  "private": false,
  "version": "6.6.1",
  "description": "Composable Nuxt 4 layers for building scalable Vue applications",
  "exports": {
    "./layers/core": "./layers/core/nuxt.config.mjs",
    "./layers/seo": "./layers/delivery/seo/nuxt.config.mjs",
    "./layers/scripts": "./layers/delivery/scripts/nuxt.config.mjs",
    "./layers/typography": "./layers/design-system/typography/nuxt.config.mjs",
    "./layers/navigation": "./layers/structure/navigation/nuxt.config.mjs",
    "./layers/visual": "./layers/design-system/visual/nuxt.config.mjs",
    "./layers/layout": "./layers/structure/layout/nuxt.config.mjs",
    "./layers/grid": "./layers/structure/grid/nuxt.config.mjs",
    "./layers/scroll": "./layers/motion/scroll/nuxt.config.mjs",
    "./layers/animations": "./layers/motion/animations/nuxt.config.mjs",
    "./layers/transitions": "./layers/motion/transitions/nuxt.config.mjs",
    "./layers/page-transitions": "./layers/motion/page-transitions/nuxt.config.mjs",
    "./layers/motion": "./layers/motion/motion/nuxt.config.mjs",
    "./layers/canvas": "./layers/render/canvas/nuxt.config.mjs",
    "./layers/shader": "./layers/render/shader/nuxt.config.mjs",
    "./layers/mailer": "./layers/data/mailer/nuxt.config.mjs",
    "./layers/forms": "./layers/data/forms/nuxt.config.mjs",
    "./layers/database": "./layers/data/database/nuxt.config.mjs",
    "./layers/auth": "./layers/data/auth/nuxt.config.mjs",
    "./layers/theming": "./layers/design-system/theming/nuxt.config.mjs",
    "./layers/content": "./layers/content/nuxt.config.mjs",
    "./layers/feeds": "./layers/delivery/feeds/nuxt.config.mjs",
    "./layers/routing": "./layers/structure/routing/nuxt.config.mjs",
    "./layers/metadata": "./layers/data/metadata/nuxt.config.mjs",
    "./layers/metadata/providers/comicvine": "./layers/data/metadata/providers/comicvine/nuxt.config.mjs",
    "./layers/metadata/providers/openlibrary": "./layers/data/metadata/providers/openlibrary/nuxt.config.mjs",
    "./layers/metadata/providers/google-books": "./layers/data/metadata/providers/google-books/nuxt.config.mjs",
    "./layers/metadata/providers/themoviedb": "./layers/data/metadata/providers/themoviedb/nuxt.config.mjs"
  },
  "files": [
    "layers/core/nuxt.config.mjs",
    "layers/*/nuxt.config.ts",
    "layers/*/app.config.ts",
    "layers/*/package.json",
    "layers/*/tsconfig.json",
    "layers/*/tailwind.config.*",
    "layers/*/app/**",
    "layers/*/public/**",
    "layers/*/server/**",
    "layers/*/shared/**",
    "layers/*/*/nuxt.config.ts",
    "layers/*/*/app.config.ts",
    "layers/*/*/package.json",
    "layers/*/*/tsconfig.json",
    "layers/*/*/tailwind.config.*",
    "layers/*/*/app/**",
    "layers/content/scripts/**",
    "layers/*/*/public/**",
    "layers/*/*/server/**",
    "layers/*/*/shared/**",
    "layers/*/*/providers/*/nuxt.config.ts",
    "layers/*/*/providers/*/package.json",
    "layers/*/*/providers/*/tsconfig.json",
    "layers/*/*/providers/*/server/**",
    "types/**",
    "docs/",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!docs/superpowers/**",
    "!docs/fallow-refactor/**",
    "!docs/*AUDIT*",
    "layers/*/nuxt.config.mjs",
    "layers/*/*/nuxt.config.mjs",
    "layers/*/*/providers/*/nuxt.config.mjs",
    "config-runtime/**",
    "!layers/**/nuxt.config.ts"
  ],
  "scripts": {
    "dev": "pnpm -F playground dev",
    "dev:debug": "pnpm -F debug dev",
    "dev:identity": "pnpm -F visual-identity dev",
    "dev:core": "PLAYGROUND_LAYERS=core pnpm -F playground dev",
    "dev:layout": "PLAYGROUND_LAYERS=core,layout pnpm -F playground dev",
    "dev:motion": "PLAYGROUND_LAYERS=core,motion pnpm -F playground dev",
    "dev:database": "PLAYGROUND_LAYERS=core,database pnpm -F playground dev",
    "dev:auth": "PLAYGROUND_LAYERS=core,auth pnpm -F playground dev",
    "build": "turbo run build",
    "lint": "vp lint && turbo run lint",
    "lint:fix": "vp lint --fix && turbo run lint -- --fix",
    "lint:style": "stylelint \"**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint \"**/*.{vue,scss,css}\" --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "content:format": "node layers/content/scripts/format-content.mjs apps/playground/content",
    "content:format:check": "node layers/content/scripts/format-content.mjs --check apps/playground/content",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run content:format:check",
    "fix": "pnpm run format && pnpm run content:format && pnpm run lint:fix && pnpm run lint:style:fix",
    "fix:layer": "f(){ pnpm turbo run lint --filter \"./layers/$1\" -- --fix && vp fmt \"layers/$1\"; }; f",
    "fix:app": "f(){ pnpm turbo run lint --filter \"./apps/$1\" -- --fix && vp fmt \"apps/$1\"; }; f",
    "validate": "pnpm run check && pnpm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "test:unit": "vp test run --project unit",
    "test:vitest": "vp test run --project vitest",
    "test:vue": "vp test run --project vue",
    "test:nuxt": "vp test run --project nuxt",
    "test:playwright": "playwright test",
    "test:e2e": "playwright test",
    "clean": "pnpm -r exec rm -rf .nuxt .output .data",
    "clean:cache": "pnpm store prune",
    "reset": "node scripts/reset.mjs",
    "reset:lockfile": "node scripts/reset.mjs --lockfile",
    "update": "ncu -i",
    "deps:check": "ncu --format group",
    "deps:update": "ncu -u && pnpm install",
    "deps:update:latest": "pnpm update --latest",
    "update:nuxt-ui": "pnpm up @nuxt/ui --latest --dedupe",
    "update:nuxt-image": "pnpm up @nuxt/image --latest --dedupe",
    "nuxtupdate": "pnpm dlx nuxi@latest upgrade --dedupe --force",
    "framework:update": "node scripts/framework-update.mjs",
    "doctor": "node scripts/doctor.mjs",
    "info": "node scripts/info.mjs",
    "rebuild": "pnpm install && pnpm turbo run build && pnpm turbo run dev",
    "commit:core": "git add layers/core && git commit -m \"chore(core): update\"",
    "commit:layout": "git add layers/layout && git commit -m \"chore(layout): update\"",
    "commit:motion": "git add layers/motion && git commit -m \"chore(motion): update\"",
    "commit:root": "git add . && git commit -m \"chore(root): update\"",
    "layer:core": "pnpm turbo run dev --filter core",
    "layer:layout": "pnpm turbo run dev --filter layout",
    "layer:motion": "pnpm turbo run dev --filter motion",
    "build:core": "pnpm turbo run build --filter core",
    "build:layout": "pnpm turbo run build --filter layout",
    "build:motion": "pnpm turbo run build --filter motion",
    "layer:generate:core": "pnpm turbo run generate --filter core",
    "layer:generate:layout": "pnpm turbo run generate --filter layout",
    "layer:generate:motion": "pnpm turbo run generate --filter motion",
    "layer:rebuild:core": "pnpm build:core && pnpm layer:generate:core && pnpm layer:core",
    "layer:rebuild:layout": "pnpm build:layout && pnpm layer:generate:layout && pnpm layer:layout",
    "layer:rebuild:motion": "pnpm build:motion && pnpm layer:generate:motion && pnpm layer:motion",
    "browserlist": "npx update-browserslist-db@latest",
    "kill": "node scripts/kill.mjs",
    "deploy": "turbo run build --filter playground",
    "build:netlify": "pnpm -F playground build:netlify",
    "dev:netlify": "pnpm -F playground dev:netlify",
    "layer:list": "node scripts/layer-list.mjs",
    "layer:check": "turbo run lint typecheck --filter './layers/*'",
    "layer:build": "turbo run build --filter './layers/*'",
    "layer:test": "turbo run test --filter './layers/*'",
    "generate:layer-configs": "node scripts/generate-layer-configs.mjs",
    "prepack": "pnpm run generate:layer-configs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kieranmansfield/nuxt-layers"
  },
  "keywords": [],
  "author": "Kieran Mansfield",

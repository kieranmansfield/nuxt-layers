{
  "name": "kmcom-layer-content",
  "type": "module",
  "version": "0.0.1",
  "main": "./nuxt.config.mjs",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p ../../tsconfig.typecheck.json",
    "dev:content": "CONTENT_STANDALONE=true nuxi dev",
    "build": "CONTENT_STANDALONE=true nuxi build",
    "generate": "CONTENT_STANDALONE=true nuxi generate",
    "lint": "eslint .",
    "content:format": "node scripts/format-content.mjs",
    "content:format:check": "node scripts/format-content.mjs --check"
  },
  "devDependencies": {
    "@nuxt/content": "catalog:"
  },
  "dependencies": {
    "@iconify-json/logos": "catalog:",
    "better-sqlite3": "catalog:"
  },
  "optionalDependencies": {}
}
